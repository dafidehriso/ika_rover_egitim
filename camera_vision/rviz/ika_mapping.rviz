Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    Splitter Ratio: 0.5
  Tree Height: 464
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.588679
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Map
    Name: 2B SLAM
    Enabled: true
    Alpha: 0.7
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
    Value: true
  - Class: octomap_rviz_plugins/OccupancyGrid
    Name: 3B OctoMap
    Enabled: true
    Topic:
      Value: /octomap_binary
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
    Alpha: 0.75
    Color: 0; 100; 255
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Derinlik engelleri
    Enabled: false
    Topic:
      Value: /ika_rover/depth/obstacles
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 255; 190; 0
    Value: false
  - Class: rviz_default_plugins/LaserScan
    Name: Lidar
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color: 255; 255; 0
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
  - Class: rviz_default_plugins/Image
    Name: Sol kamera
    Enabled: false
    Topic:
      Value: /ika_rover/camera_sensor/image_raw
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Value: false
  - Class: rviz_default_plugins/Image
    Name: Sağ kamera
    Enabled: false
    Topic:
      Value: /ika_rover/right_camera_sensor/image_raw
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Value: false
  - Class: rviz_default_plugins/Image
    Name: Stereo disparity
    Enabled: true
    Topic:
      Value: /ika_rover/stereo/disparity_visual
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 5
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: null
