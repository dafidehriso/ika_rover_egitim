<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://apriltag_0</uri>
      <name>apriltag_0</name>
      <pose>2 0 0.15 0 0 1.5708</pose>
    </include>

    <model name="red_box">
      <static>true</static>
      <pose>1 1 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="green_box">
      <static>true</static>
      <pose>1 -1 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="blue_box">
      <static>true</static>
      <pose>2 1.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

  
    <model name="wall_leg1_south">
      <static>true</static>
      <pose>6.5 -1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg1_north">
      <static>true</static>
      <pose>6.5 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg2_west">
      <static>true</static>
      <pose>8 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg2_east">
      <static>true</static>
      <pose>10 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material>
        </visual>
      </link>
    </model>


    <model name="wood_pillar">
      <static>true</static>
      <pose>5 0.3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="painted_curb">
      <static>true</static>
      <pose>7.5 -0.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material>
        </visual>
      </link>
    </model>

    <model name="brick_pillar_leg2">
      <static>true</static>
      <pose>9 5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <model name="entry_ramp">
      <static>true</static>
      <pose>2.5 0 0.03 0 -0.06 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 1.8 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 1.8 0.06</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script></material>
        </visual>
      </link>
    </model>


    <model name="wall_leg3_south">
      <static>true</static>
      <pose>4 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.1 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg3_north">
      <static>true</static>
      <pose>4 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.1 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/PaintedWall</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg4_west">
      <static>true</static>
      <pose>-2 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_leg4_east">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

<model name="ika_rover">

    <!-- ==================== -->
    <!-- GÖVDE -->
    <!-- ==================== -->
    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
      </visual>
    </link>

    <!-- ==================== -->
    <!-- SOL TEKER -->
    <!-- ==================== -->
    <link name="left_wheel">
      <pose>0 0.25 0.1 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
      </visual>
    </link>

    <!-- ==================== -->
    <!-- SAĞ TEKER -->
    <!-- ==================== -->
    <link name="right_wheel">
      <pose>0 -0.25 0.1 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
      </visual>
    </link>

    <!-- ==================== -->
    <!-- DENGE TEKERİ (CASTER) -->
    <!-- ==================== -->
    <link name="caster_wheel">
      <pose>-0.2 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_wheel</child>
    </joint>

    <!-- ==================== -->
    <!-- IMU -->
    <!-- ==================== -->
    <link name="imu_link">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>50.0</update_rate>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- ==================== -->
    <!-- LIDAR -->
    <!-- ==================== -->
    <link name="lidar_link">
      <pose>0.2 0 0.3 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.05</length></cylinder></geometry>
      </visual>
      <sensor name="lidar_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.015</resolution>
          </range>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ==================== -->
    <!-- KAMERA -->
    <!-- ==================== -->
    <link name="camera_link">
      <pose>0.3 0 0.2 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ika_rover</namespace>


          </ros>
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
      <sensor name="depth_camera_sensor" type="depth">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <depth_camera/>
          <clip><near>0.25</near><far>8.0</far></clip>
        </camera>
        <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/ika_rover</namespace></ros>
          <camera_name>depth_camera</camera_name>
          <frame_name>camera_optical_frame</frame_name>
          <min_depth>0.25</min_depth>
          <max_depth>8.0</max_depth>
        </plugin>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ==================== -->
    <!-- SAĞ KAMERA (STEREO ÇİFT) -->
    <!-- ==================== -->
    <link name="right_camera_link">
      <pose>0.3 -0.12 0.2 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_camera_visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="right_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
        </camera>
        <plugin name="right_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ika_rover</namespace>


          </ros>
          <frame_name>right_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="right_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_camera_link</child>
    </joint>

    <joint name="side_right_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>side_right_camera_link</child>
    </joint>
    <link name="side_right_camera_link">
      <pose>0 -0.25 0.2 0 0 -1.5708</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="side_right_camera_visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="side_right_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15</far></clip>
        </camera>
        <plugin name="side_right_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ika_rover</namespace>


          </ros>
          <frame_name>side_right_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="side_left_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>side_left_camera_link</child>
    </joint>
    <link name="side_left_camera_link">
      <pose>0 0.25 0.2 0 0 1.5708</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="side_left_camera_visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="side_left_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15</far></clip>
        </camera>
        <plugin name="side_left_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ika_rover</namespace>


          </ros>
          <frame_name>side_left_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="rear_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_camera_link</child>
    </joint>
    <link name="rear_camera_link">
      <pose>-0.3 0 0.2 0 0 3.14159</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rear_camera_visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="rear_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15</far></clip>
        </camera>
        <plugin name="rear_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/ika_rover</namespace>


          </ros>
          <frame_name>rear_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>


    <joint name="front_caster_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster_left</child>
    </joint>
    <link name="front_caster_left">
      <pose>0.35 0.15 0.05 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="front_caster_left_collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="front_caster_left_visual">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </visual>
    </link>

    <joint name="front_caster_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster_right</child>
    </joint>
    <link name="front_caster_right">
      <pose>0.35 -0.15 0.05 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="front_caster_right_collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="front_caster_right_visual">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </visual>
    </link>

    <!-- ==================== -->
    <!-- DİFERANSİYEL SÜRÜŞ -->
    <!-- ==================== -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>

  </model>
  </world>
</sdf>
